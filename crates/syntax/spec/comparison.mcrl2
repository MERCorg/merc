% Specification of the polymorphic comparison operators and the conditional
% `if`, present for every sort.

type_var S;

map ==: S # S -> Bool;
    !=: S # S -> Bool;
    <: S # S -> Bool;
    <=: S # S -> Bool;
    >: S # S -> Bool;
    >=: S # S -> Bool;
% A total order on S, used by Set, Bag and FSet/FBag to keep their internal
% element lists canonically sorted even when `<` (e.g. subset) is not total.
    less_total: S # S -> Bool;
    if: Bool # S # S -> S;

var x, y: S;
eqn x == x = true;
    x != y = !(x == y);
    x < x = false;
    x <= x = true;
    x > y = y < x;
    x >= y = y <= x;
    less_total(x, x) = false;
    if(true, x, y) = x;
    if(false, x, y) = y;

